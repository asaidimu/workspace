    "32kfv8": {
      "id": "32kfv8",
      "category": "issue",
      "status": "open",
      "title": "Inefficient data access",
      "body": "Anansi provides a powerfull and flexible query language. Here we\nread all rows, then count them in memory. This problem might be\nduplicated elsewhere.\nAnansi also provides a sensible default for the id property, enforced\nas chronological, uuidv7s. This allows efficient sorting of data\nSee other issues relating to subpar solutions to problems already\nsolved by anansi.\n",
      "location": {
        "file": "store/anansistore/blobs.go",
        "startLine": 380,
